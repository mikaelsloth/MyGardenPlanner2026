@page "/Account/AccessDenied"

@using Microsoft.AspNetCore.Identity
@using MyGardenPlanner2026.Core.Entities

@inject UserManager<ApplicationUser> UserManager

<PageTitle>Adgang nægtet – MyGardenPlanner</PageTitle>

<AuthPageShell Title="Adgang nægtet">
    @if (requiresTwoFactorSetup)
    {
        <div class="status-message status-danger status-page" role="alert">
            <span class="status-dot" aria-hidden="true"></span>
            <div class="status-message-text">
                <p>Adgang til denne funktion kræver, at du har totrinsbekræftelse aktiveret på din konto.</p>
                <p><a href="Account/Manage/EnableAuthenticator">Opsæt totrinsbekræftelse</a></p>
            </div>
        </div>
    }
    else
    {
        <div class="status-message status-danger status-page" role="alert">
            <span class="status-dot" aria-hidden="true"></span>
            <div class="status-message-text">
                <p>Du har ikke adgang til denne ressource.</p>
            </div>
        </div>
    }
</AuthPageShell>