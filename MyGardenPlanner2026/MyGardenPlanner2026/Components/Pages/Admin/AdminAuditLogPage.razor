@page "/admin/audit-log"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = MyGardenPlanner2026.Configuration.Extensions.AuthorizationServicesExtensions.RequireAuditViewerPolicy)]
@rendermode InteractiveServer

<PageTitle>AuditLog – MyGardenPlanner</PageTitle>

<div class="container-fluid px-3 px-md-4 admin-audit-log-page">
    <h1>AuditLog</h1>
    <p class="card-description">Søg og filtrér i systemets revisionslog. Visningen er skrivebeskyttet.</p>

    <AuditLogFilterBar InitialFilter="currentFilter" EntityNameOptions="entityNameOptions" OnSearch="HandleSearchAsync" />

    <AuditLogResultsTable Result="result" OnPageChanged="HandlePageChangedAsync" OnViewDetails="HandleViewDetails" />

    <AuditLogExportPanel CurrentFilter="currentFilter" />

    <AuditLogDetailModal Entry="selectedEntryForDetail" IsOpen="showDetailModal" OnClose="HandleCloseDetail" />
</div>