@namespace MyGardenPlanner2026.Components.Domain.Admin

@using MyGardenPlanner2026.Components.Account.Shared

<div class="security-policy-editor card card-entity" data-density="default">
    @if (errorMessage is not null)
    {
        <div class="status-message status-danger status-section" role="alert">
            <span class="status-dot" aria-hidden="true"></span>
            <div class="status-message-text"><p>@errorMessage</p></div>
        </div>
    }

    @if (settings is null)
    {
        <div class="skeleton-card" aria-hidden="true">
            <div class="skeleton-line skeleton-title"></div>
            <div class="skeleton-line skeleton-meta"></div>
        </div>
    }
    else
    {
        <div class="form-grid form-grid-2">
            <div class="field">
                <label class="field-label" for="exportjob-retention">Opbevaring af færdige eksportfiler (timer)</label>
                <input id="exportjob-retention" type="number" min="1" class="form-control"
                       value="@retentionHoursEdit" @onchange="e => retentionHoursEdit = ParseInt(e.Value)" />
                <p class="help">Hvor længe en færdig eksportfil kan downloades, før den ryddes automatisk.</p>
            </div>
            <div class="field">
                <label class="field-label" for="exportjob-maxactive">Maks. igangværende eksporter pr. bruger</label>
                <input id="exportjob-maxactive" type="number" min="1" class="form-control"
                       value="@maxActiveEdit" @onchange="e => maxActiveEdit = ParseInt(e.Value)" />
                <p class="help">Antal Afventer/Kører-jobs en bruger må have samtidigt.</p>
            </div>
        </div>

        <div class="form-actions">
            <button type="button" class="btn btn-primary" @onclick="SaveAsync">Gem</button>
        </div>
    }

    <StepUpReAuthModal IsOpen="stepUpGuard.ShowModal" OnReAuthenticated="stepUpGuard.ExecutePendingActionAsync" OnCancel="stepUpGuard.Cancel" />
</div>