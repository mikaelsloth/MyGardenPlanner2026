﻿@if (!string.IsNullOrEmpty(DisplayMessage))
{
    @if (StatusVariant == "danger")
    {
        <div class="status-message status-danger status-page" role="alert">
            <span class="status-dot" aria-hidden="true"></span>
            <div class="status-message-text"><p>@DisplayMessage</p></div>
        </div>
    }
    else
    {
        <div class="status-message status-success status-page" role="status" aria-live="polite">
            <span class="status-dot" aria-hidden="true"></span>
            <div class="status-message-text"><p>@DisplayMessage</p></div>
        </div>
    }
}