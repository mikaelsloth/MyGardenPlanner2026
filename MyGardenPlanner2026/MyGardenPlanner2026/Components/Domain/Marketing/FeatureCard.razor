@namespace MyGardenPlanner2026.Components.Domain.Marketing

<div class="card card-entity feature-card" data-density="default">
    <span class="badge-role badge-primary feature-card-badge">@AccessLevel.ToDisplayName()</span>
    <h3 class="feature-card-title">@Title</h3>
    <p class="card-description feature-card-description">@Description</p>
</div>