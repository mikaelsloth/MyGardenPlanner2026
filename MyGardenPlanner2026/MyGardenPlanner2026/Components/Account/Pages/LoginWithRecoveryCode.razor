@page "/Account/LoginWithRecoveryCode"

@using Microsoft.AspNetCore.Identity
@using MyGardenPlanner2026.Core.Entities;

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject IReAuthenticationService ReAuthenticationService
@inject IReAuthFailureTracker ReAuthFailureTracker
@inject ICurrentUserAccessor CurrentUserAccessor
@inject ILogger<LoginWithRecoveryCode> Logger

<PageTitle>Gendannelseskode – MyGardenPlanner</PageTitle>

<AuthPageShell Title="Bekræft med gendannelseskode" Subtitle="Dette login huskes ikke, før du bruger en godkendelseskode ved login, eller deaktiverer totrinsbekræftelse og logger ind igen.">
    <StatusMessage Message="@message" />
    <EditForm Model="Input" FormName="login-with-recovery-code" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />

        <div class="field">
            <label class="field-label" for="Input.RecoveryCode">Gendannelseskode</label>
            <InputText @bind-Value="Input.RecoveryCode" id="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="Gendannelseskode" />
            <ValidationMessage For="() => Input.RecoveryCode" class="field-message" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary w-100">Log ind</button>
        </div>
    </EditForm>
</AuthPageShell>
