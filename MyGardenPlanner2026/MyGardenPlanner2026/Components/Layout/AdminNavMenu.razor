@namespace MyGardenPlanner2026.Components.Layout

<nav class="admin-nav-menu" aria-label="Administration">
    <ul class="list-unstyled d-flex flex-column gap-1 nav-drawer-list">
        @foreach (var item in visibleItems)
        {
            <li @key="item.Href">
                <NavLink class="nav-link-item" href="@item.Href">
                    @item.Label
                    @if (item.Href == AuditLogHref && unseenExportJobCount > 0)
                    {
                        <span class="nav-badge" aria-label="@($"{unseenExportJobCount} nye eksportfiler klar")">@unseenExportJobCount</span>
                    }
                </NavLink>
            </li>
        }
    </ul>
</nav>