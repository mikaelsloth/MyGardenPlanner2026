@page "/not-found"
@layout MyGardenPlanner2026.Components.Layout.PublicLayout

<PageTitle>Side ikke fundet – MyGardenPlanner</PageTitle>

<section class="section">
    <div class="container-fluid px-3 px-md-4">
        <div class="empty-state empty-search">
            <div class="empty-icon" aria-hidden="true">
                <i class="bi bi-signpost-split"></i>
            </div>
            <div class="empty-content">
                <h1>Siden blev ikke fundet</h1>
                <p>Beklager, men det indhold du leder efter, findes ikke.</p>
            </div>
            <div class="empty-actions">
                <a href="/" class="btn btn-primary">Gå til forsiden</a>
            </div>
        </div>
    </div>
</section>