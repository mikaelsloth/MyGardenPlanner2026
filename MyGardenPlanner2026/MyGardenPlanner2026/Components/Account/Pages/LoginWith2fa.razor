@page "/Account/LoginWith2fa"

@using Microsoft.AspNetCore.Identity
@using MyGardenPlanner2026.Core.Entities;

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<LoginWith2fa> Logger
@inject IReAuthenticationService ReAuthenticationService

<PageTitle>Totrinsbekræftelse – MyGardenPlanner</PageTitle>

<AuthPageShell Title="Totrinsbekræftelse" Subtitle="Dit login er beskyttet med en godkender-app. Indtast koden fra din app nedenfor.">
    <StatusMessage Message="@message" />
    <EditForm Model="Input" FormName="login-with-2fa" OnValidSubmit="OnValidSubmitAsync" method="post">
        <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
        <input type="hidden" name="RememberMe" value="@RememberMe" />
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />

        <div class="field">
            <label class="field-label" for="Input.TwoFactorCode">Godkendelseskode</label>
            <InputText @bind-Value="Input.TwoFactorCode" id="Input.TwoFactorCode" class="form-control" autocomplete="off" />
            <ValidationMessage For="() => Input.TwoFactorCode" class="field-message" />
        </div>

        <div class="check-row">
            <InputCheckbox @bind-Value="Input.RememberMachine" id="remember-machine" class="form-check-input" />
            <label class="field-label" for="remember-machine">Husk denne enhed</label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary w-100">Log ind</button>
        </div>
    </EditForm>

    <p class="mt-3">
        Har du ikke adgang til din godkender-enhed? Du kan
        <a href="Account/LoginWithRecoveryCode?ReturnUrl=@ReturnUrl">logge ind med en gendannelseskode</a>.
    </p>
</AuthPageShell>
