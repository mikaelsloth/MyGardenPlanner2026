@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Identity
@using MyGardenPlanner2026.Core.Entities;

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Totrinsbekræftelse (2FA) – MyGardenPlanner</PageTitle>

<StatusMessage />
<h3>Totrinsbekræftelse (2FA)</h3>
@if (canTrack)
{
    if (is2faEnabled)
    {
        if (recoveryCodesLeft == 0)
        {
            <div class="alert alert-danger">
                <strong>Du har ikke flere gendannelseskoder.</strong>
                <p>Du skal <a href="Account/Manage/GenerateRecoveryCodes">generere et nyt sæt gendannelseskoder</a>, før du kan logge ind med en gendannelseskode.</p>
            </div>
        }
        else if (recoveryCodesLeft == 1)
        {
            <div class="alert alert-danger">
                <strong>Du har 1 gendannelseskode tilbage.</strong>
                <p>Du kan <a href="Account/Manage/GenerateRecoveryCodes">generere et nyt sæt gendannelseskoder</a>.</p>
            </div>
        }
        else if (recoveryCodesLeft <= 3)
        {
            <div class="alert alert-warning">
                <strong>Du har @recoveryCodesLeft gendannelseskoder tilbage.</strong>
                <p>Du bør <a href="Account/Manage/GenerateRecoveryCodes">generere et nyt sæt gendannelseskoder</a>.</p>
            </div>
        }

        if (isMachineRemembered)
        {
            <form style="display: inline-block" @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-primary">Glem denne browser</button>
            </form>
        }

        <a href="Account/Manage/Disable2fa" class="btn btn-primary">Deaktivér 2FA</a>
        <a href="Account/Manage/GenerateRecoveryCodes" class="btn btn-primary">Nulstil gendannelseskoder</a>
    }

    <h4>Authenticator-app</h4>
    @if (!hasAuthenticator)
    {
        <a href="Account/Manage/EnableAuthenticator" class="btn btn-primary">Tilføj authenticator-app</a>
    }
    else
    {
        <a href="Account/Manage/EnableAuthenticator" class="btn btn-primary">Konfigurer authenticator-app</a>
        <a href="Account/Manage/ResetAuthenticator" class="btn btn-primary">Nulstil authenticator-app</a>
    }
}
else
{
    <div class="alert alert-danger">
        <strong>Privatlivs- og cookiepolitikken er ikke accepteret.</strong>
        <p>Du skal acceptere politikken, før du kan aktivere totrinsbekræftelse.</p>
    </div>
}