@page "/Account/Manage/GenerateRecoveryCodes"

@using Microsoft.AspNetCore.Identity
@using MyGardenPlanner2026.Core.Entities;

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<GenerateRecoveryCodes> Logger

<PageTitle>Generér gendannelseskoder til 2FA – MyGardenPlanner</PageTitle>

@if (recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="recoveryCodes.ToArray()" StatusMessage="@message" />
}
else
{
    <h3>Generér gendannelseskoder til 2FA</h3>
    <div class="alert alert-warning" role="alert">
        <p>
            <span class="glyphicon glyphicon-warning-sign"></span>
            <strong>Opbevar disse koder et sikkert sted.</strong>
        </p>
        <p>
            Hvis du mister din enhed og ikke har gendannelseskoderne, mister du adgangen til din konto.
        </p>
        <p>
            Nye gendannelseskoder ændrer ikke nøglerne i authenticator-apps. Hvis du vil ændre nøglen
            i en authenticator-app, skal du <a href="Account/Manage/ResetAuthenticator">nulstille dine authenticator-nøgler</a>.
        </p>
    </div>
    <div>
        <form @formname="generate-recovery-codes" @onsubmit="OnSubmitAsync" method="post">
            <AntiforgeryToken />
            <button class="btn btn-danger" type="submit">Generér gendannelseskoder</button>
        </form>
    </div>
}