@page "/Account/ResendEmailConfirmation"

@using Microsoft.AspNetCore.Identity
@using MyGardenPlanner2026.Core.Entities;

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Gensend bekræftelses-e-mail – MyGardenPlanner</PageTitle>

<AuthPageShell Title="Gensend bekræftelses-e-mail" Subtitle="Indtast din e-mail.">
    <StatusMessage Message="@message" />
    <EditForm Model="Input" FormName="resend-email-confirmation" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />

        <div class="field">
            <label class="field-label" for="Input.Email">E-mail</label>
            <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" aria-required="true" placeholder="navn@eksempel.dk" />
            <ValidationMessage For="() => Input.Email" class="field-message" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary w-100">Gensend</button>
        </div>
    </EditForm>
</AuthPageShell>
