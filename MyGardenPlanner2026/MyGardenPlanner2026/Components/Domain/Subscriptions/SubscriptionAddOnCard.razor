@namespace MyGardenPlanner2026.Components.Domain.Subscriptions

<div class="card card-entity addon-card" data-density="default">
    <div class="card-header">
        <h4 class="addon-card-title">@AddOn.Name</h4>
    </div>
    <p class="card-description addon-card-unit">@AddOn.UnitDescription</p>
    <div class="addon-card-prices">
        <span class="numeric">@FormattedAnnualPrice /år</span>
        <span class="numeric">@FormattedMonthlyPrice /md.</span>
        <span class="numeric">@FormattedPerpetualPrice (engang)</span>
    </div>
</div>