@namespace MyGardenPlanner2026.Components.Layout
@inherits LayoutComponentBase

<a href="#main-content" class="sr-only sr-only-focusable btn btn-primary position-absolute p-2 m-2">
    Spring til hovedindhold
</a>

<div class="app-shell">
    <aside class="desktop-sidebar">
        <a href="/" class="app-sidebar-brand text-decoration-none">
            <span class="app-sidebar-brand-text">MyGardenPlanner</span>
        </a>

        <div class="mt-auto app-sidebar-user">
            <AuthorizeView>
                <Authorized>
                    <p class="app-sidebar-user-email">@context.User.Identity?.Name</p>
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="/" />
                        <button type="submit" class="nav-link-item app-sidebar-logout-btn">Log ud</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </aside>

    <div class="app-shell-main-column">
        <header class="mobile-header">
            <button type="button"
                    class="btn p-2 border-0"
                    @onclick="ToggleMobileMenu"
                    aria-label="Åbn menu"
                    aria-expanded="@isMobileMenuOpen.ToString()">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z" />
                </svg>
            </button>
            <span class="app-mobile-header-brand">MyGardenPlanner</span>
        </header>

        <main id="main-content">
            <OnboardingGate>
                @Body
            </OnboardingGate>
        </main>
    </div>
</div>

<AppNavDrawer IsOpen="isMobileMenuOpen" OnClose="CloseMobileMenu" />