@namespace MyGardenPlanner2026.Components.Domain.Admin

@using MyGardenPlanner2026.Components.Account.Shared
@inherits PolicyEditorBase

<div class="security-policy-editor card card-entity" data-density="default">
    @if (ErrorMessage is not null)
    {
        <div class="status-message status-danger status-section" role="alert">
            <span class="status-dot" aria-hidden="true"></span>
            <div class="status-message-text"><p>@ErrorMessage</p></div>
        </div>
    }

    @if (settings is null)
    {
        <div class="skeleton-card" aria-hidden="true">
            <div class="skeleton-line skeleton-title"></div>
            <div class="skeleton-line skeleton-meta"></div>
        </div>
    }
    else
    {
        <div class="form-grid form-grid-2">
            <div class="field">
                <label class="field-label" for="failtrack-threshold">Tærskel (antal fejl)</label>
                <input id="failtrack-threshold" type="number" min="1" class="form-control"
                       value="@thresholdEdit" @onchange="e => thresholdEdit = ParseInt(e.Value)" />
                <p class="help">Antal fejlede MFA/re-auth-forsøg før der udløses en sikkerhedsalarm.</p>
            </div>
            <div class="field">
                <label class="field-label" for="failtrack-windowdays">Tidsvindue (dage)</label>
                <input id="failtrack-windowdays" type="number" min="1" class="form-control"
                       value="@windowDaysEdit" @onchange="e => windowDaysEdit = ParseInt(e.Value)" />
                <p class="help">Det glidende vindue, som fejlede forsøg tælles indenfor.</p>
            </div>
        </div>

        <div class="form-actions">
            <button type="button" class="btn btn-primary" @onclick="SaveAsync">Gem</button>
        </div>
    }

    <StepUpReAuthModal IsOpen="StepUpGuard.ShowModal" OnReAuthenticated="StepUpGuard.ExecutePendingActionAsync" OnCancel="StepUpGuard.Cancel" />
</div>