@page "/Account/ResetPassword"

@using Microsoft.AspNetCore.Identity
@using MyGardenPlanner2026.Core.Entities;

@inject IdentityRedirectManager RedirectManager
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Nulstil adgangskode – MyGardenPlanner</PageTitle>

<AuthPageShell Title="Nulstil adgangskode" Subtitle="Nulstil din adgangskode.">
    <StatusMessage Message="@Message" />
    <EditForm Model="Input" FormName="reset-password" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />

        <input type="hidden" name="Input.Code" value="@Input.Code" />

        <div class="field">
            <label class="field-label" for="Input.Email">E-mail</label>
            <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="navn@eksempel.dk" />
            <ValidationMessage For="() => Input.Email" class="field-message" />
        </div>

        <div class="field">
            <label class="field-label" for="Input.Password">Adgangskode</label>
            <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Indtast din nye adgangskode" />
            <ValidationMessage For="() => Input.Password" class="field-message" />
        </div>

        <div class="field">
            <label class="field-label" for="Input.ConfirmPassword">Bekræft adgangskode</label>
            <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Gentag din nye adgangskode" />
            <ValidationMessage For="() => Input.ConfirmPassword" class="field-message" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary w-100">Nulstil</button>
        </div>
    </EditForm>
</AuthPageShell>
