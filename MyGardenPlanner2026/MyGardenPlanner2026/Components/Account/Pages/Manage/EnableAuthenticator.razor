@page "/Account/Manage/EnableAuthenticator"

@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using MyGardenPlanner2026.Core.Entities;

@inject UserManager<ApplicationUser> UserManager
@inject UrlEncoder UrlEncoder
@inject IdentityRedirectManager RedirectManager
@inject ILogger<EnableAuthenticator> Logger

<PageTitle>Konfigurer authenticator-app – MyGardenPlanner</PageTitle>

@if (recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="recoveryCodes.ToArray()" StatusMessage="@message" />
}
else
{
    <StatusMessage Message="@message" />
    <h3>Konfigurer authenticator-app</h3>
    <div>
        <p>Følg disse trin for at bruge en authenticator-app:</p>
        <ol class="list">
            <li>
                <p>
                    Download en authenticator-app til totrinsbekræftelse, fx Microsoft Authenticator til
                    <a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a> og
                    <a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a> eller
                    Google Authenticator til
                    <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=da">Android</a> og
                    <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a>.
                </p>
            </li>
            <li>
                <p>Scan QR-koden, eller indtast denne nøgle <kbd>@sharedKey</kbd> i din authenticator-app. Mellemrum og store/små bogstaver er ligegyldige.</p>
                <div class="alert alert-info">Læs, hvordan du <a href="https://go.microsoft.com/fwlink/?Linkid=852423">aktiverer generering af QR-koder</a>.</div>
                <div></div>
                <div data-url="@authenticatorUri"></div>
            </li>
            <li>
                <p>
                    Når du har scannet QR-koden eller indtastet nøglen ovenfor, giver din authenticator-app dig
                    en unik kode. Indtast koden i feltet herunder.
                </p>
                <div class="row">
                    <div class="col-xl-6">
                        <EditForm Model="Input" FormName="send-code" OnValidSubmit="OnValidSubmitAsync" method="post">
                            <DataAnnotationsValidator />
                            <div class="form-floating mb-3">
                                <InputText @bind-Value="Input.Code" id="Input.Code" class="form-control" autocomplete="off" placeholder="Indtast koden" />
                                <label for="Input.Code" class="control-label form-label">Bekræftelseskode</label>
                                <ValidationMessage For="() => Input.Code" class="text-danger" />
                            </div>
                            <button type="submit" class="w-100 btn btn-lg btn-primary">Bekræft</button>
                            <ValidationSummary class="text-danger" role="alert" />
                        </EditForm>
                    </div>
                </div>
            </li>
        </ol>
    </div>
}