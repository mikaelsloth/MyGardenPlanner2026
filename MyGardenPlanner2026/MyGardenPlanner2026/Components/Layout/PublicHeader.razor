@namespace MyGardenPlanner2026.Components.Layout
@rendermode InteractiveServer

<header class="public-header border-bottom sticky-top">
    <nav class="container-fluid px-3 px-md-4 py-2 d-flex align-items-center justify-content-between" aria-label="Hovednavigation">
        <!-- Logo & Brand -->
        <div class="d-flex align-items-center gap-3">
            <button type="button"
                    class="btn d-lg-none p-2 border-0 header-touch-target"
                    @onclick="ToggleMobileMenu"
                    aria-label="Åbn menu"
                    aria-expanded="@isMobileMenuOpen.ToString()">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z" />
                </svg>
            </button>

            <a href="/" class="d-flex align-items-center text-decoration-none text-dark fw-bold fs-5 header-touch-target">
                <span class="brand-text">MyGardenPlanner</span>
            </a>
        </div>

        <!-- Desktop Navigation Links -->
        <div class="d-none d-lg-flex align-items-center gap-4">
            <NavLink class="nav-link text-body header-touch-target d-flex align-items-center" href="/" Match="NavLinkMatch.All">
                Forside
            </NavLink>
            <NavLink class="nav-link text-body header-touch-target d-flex align-items-center" href="/pricing">
                Priser & Abonnement
            </NavLink>
        </div>

        <!-- Desktop Action Buttons -->
        <div class="d-flex align-items-center gap-2">
            <a href="/account/login" class="btn btn-ghost header-touch-target d-inline-flex align-items-center">
                Log ind
            </a>
            <a href="/account/register" class="btn btn-primary header-touch-target d-inline-flex align-items-center">
                Opret bruger
            </a>
        </div>
    </nav>
</header>

<!-- Drawer bor i samme interaktive ø som knappen, der styrer den -->
<NavDrawer IsOpen="isMobileMenuOpen" OnClose="CloseMobileMenu" />