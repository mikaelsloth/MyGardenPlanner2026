@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using MyGardenPlanner2026.Core.Entities;

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Personlige data – MyGardenPlanner</PageTitle>

<StatusMessage />
<h3>Personlige data</h3>

<div class="row">
    <div class="col-md-6">
        <p>Din konto indeholder personlige data, som du har givet os. På denne side kan du downloade eller slette dem.</p>
        <p>
            <strong>Sletning af disse data fjerner din konto permanent og kan ikke fortrydes.</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">Download</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">Slet</a>
        </p>
    </div>
</div>