@page "/Account/ExternalLogin"

@using Microsoft.AspNetCore.Identity
@using MyGardenPlanner2026.Core.Entities;

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ExternalLogin> Logger

<PageTitle>Opret bruger – MyGardenPlanner</PageTitle>

<AuthPageShell Title="Opret bruger" Subtitle="@($"Tilknyt din {ProviderDisplayName}-konto.")">
    <StatusMessage Message="@message" />

    <div class="status-message status-info status-section" role="status">
        <span class="status-dot" aria-hidden="true"></span>
        <div class="status-message-text">
            <p>
                Du er nu godkendt med <strong>@ProviderDisplayName</strong>.
                Indtast en e-mailadresse nedenfor, og klik på "Opret bruger" for at færdiggøre login.
            </p>
        </div>
    </div>

    <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync" FormName="confirmation" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />

        <div class="field">
            <label class="field-label" for="Input.Email">E-mail</label>
            <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="email" placeholder="navn@eksempel.dk" />
            <ValidationMessage For="() => Input.Email" class="field-message" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary w-100">Opret bruger</button>
        </div>
    </EditForm>
</AuthPageShell>
