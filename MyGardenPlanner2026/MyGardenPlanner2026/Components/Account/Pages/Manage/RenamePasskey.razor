@page "/Account/Manage/RenamePasskey/{Id}"

@using MyGardenPlanner2026.Core.Entities;
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Omdøb passkey – MyGardenPlanner</PageTitle>

<EditForm Model="Input" OnValidSubmit="RenameAsync" FormName="rename-passkey" method="post">
    <DataAnnotationsValidator />
    @if (passkey?.Name is { } name)
    {
        <h4>Angiv et nyt navn til din passkey "@name"</h4>
    }
    else
    {
        <h4>Angiv et navn til din passkey</h4>
    }
    <hr />
    <ValidationSummary class="text-danger" role="alert" />
    <div class="form-floating mb-3">
        <InputText @bind-Value="Input.Name" id="Input.Name" class="form-control" aria-required="true" placeholder="Min passkey" />
        <label for="Input.Name" class="form-label">Passkey-navn</label>
        <ValidationMessage For="() => Input.Name" class="text-danger" />
    </div>
    <div>
        <button type="submit" class="w-100 btn btn-lg btn-primary">Fortsæt</button>
    </div>
</EditForm>