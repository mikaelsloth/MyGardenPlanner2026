@page "/Account/ForgotPassword"

@using Microsoft.AspNetCore.Identity
@using MyGardenPlanner2026.Core.Entities;

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Glemt adgangskode – MyGardenPlanner</PageTitle>

<AuthPageShell Title="Glemt adgangskode?" Subtitle="Indtast din e-mail, så sender vi et link til nulstilling.">
    <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />

        <div class="field">
            <label class="field-label" for="Input.Email">E-mail</label>
            <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="navn@eksempel.dk" />
            <ValidationMessage For="() => Input.Email" class="field-message" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary w-100">Nulstil adgangskode</button>
        </div>
    </EditForm>
</AuthPageShell>
