﻿
<StatusMessage Message="@StatusMessage" />
<h3>Gendannelseskoder</h3>
<div class="status-message status-warning status-section" role="status" aria-live="polite">
    <span class="status-dot" aria-hidden="true"></span>
    <div class="status-message-text">
        <strong>Gem disse koder et sikkert sted.</strong>
        <p>Hvis du mister din enhed og ikke har gendannelseskoderne, mister du adgangen til din konto.</p>
    </div>
</div>
<div class="form-grid form-grid-2 recovery-code-grid">
    @foreach (var recoveryCode in RecoveryCodes)
    {
        <code class="mono recovery-code">@recoveryCode</code>
    }
</div>