@page "/Account/Manage/Disable2fa"

@using Microsoft.AspNetCore.Identity
@using MyGardenPlanner2026.Core.Entities;

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<Disable2fa> Logger

<PageTitle>Deaktivér totrinsbekræftelse (2FA) – MyGardenPlanner</PageTitle>

<StatusMessage />
<h3>Deaktivér totrinsbekræftelse (2FA)</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Denne handling deaktiverer kun 2FA.</strong>
    </p>
    <p>
        Deaktivering af 2FA ændrer ikke nøglerne i authenticator-apps. Hvis du vil ændre nøglen
        i en authenticator-app, skal du <a href="Account/Manage/ResetAuthenticator">nulstille dine authenticator-nøgler</a>.
    </p>
</div>

<div>
    <form @formname="disable-2fa" @onsubmit="OnSubmitAsync" method="post">
        <AntiforgeryToken />
        <button class="btn btn-danger" type="submit">Deaktivér 2FA</button>
    </form>
</div>