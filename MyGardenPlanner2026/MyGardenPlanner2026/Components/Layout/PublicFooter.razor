@namespace MyGardenPlanner2026.Components.Layout

<footer class="public-footer border-top py-5">
    <div class="container-fluid px-3 px-md-4">
        <div class="row g-4">
            <!-- Col 1: App summary & copyright -->
            <div class="col-12 col-md-6 col-lg-3">
                <h2 class="h6 fw-bold text-uppercase brand-heading mb-3">MyGardenPlanner</h2>
                <p class="text-muted small mb-3">
                    Din digitale platform til altomfattende havedesign, planteplanlægning og udendørs eksekvering.
                </p>
                <p class="text-muted small mb-0">
                    &copy; @DateTime.UtcNow.Year MyGardenPlanner. Alle rettigheder forbeholdes.
                </p>
            </div>

            <!-- Col 2: Navigation links -->
            <div class="col-12 col-md-6 col-lg-3">
                <h3 class="h6 fw-bold mb-3 footer-section-title">Navigation</h3>
                <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                    <li>
                        <a href="/" class="footer-link">Forside</a>
                    </li>
                    <li>
                        <a href="/pricing" class="footer-link">Priser & Abonnement</a>
                    </li>
                    <li>
                        <a href="/about" class="footer-link">Om platformen</a>
                    </li>
                    <li>
                        <a href="/terms" class="footer-link">Handelsbetingelser</a>
                    </li>
                    <li>
                        <a href="/privacy" class="footer-link">Privatlivspolitik</a>
                    </li>
                </ul>
            </div>

            <!-- Col 3: Subscription & Pricing links -->
            <div class="col-12 col-md-6 col-lg-3">
                <h3 class="h6 fw-bold mb-3 footer-section-title">Abonnementer</h3>
                <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                    <li>
                        <a href="/pricing#free" class="footer-link">Gratis / Havenørd</a>
                    </li>
                    <li>
                        <a href="/pricing#pro" class="footer-link">Pro-Gartner</a>
                    </li>
                    <li>
                        <a href="/pricing#faq" class="footer-link">Ofte stillede spørgsmål</a>
                    </li>
                </ul>
            </div>

            <!-- Col 4: System status / Version -->
            <div class="col-12 col-md-6 col-lg-3">
                <h3 class="h6 fw-bold mb-3 footer-section-title">Systemstatus</h3>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="status-indicator-dot bg-success rounded-circle"></span>
                    <span class="small text-muted">Driftstatus: Normal</span>
                </div>
                <p class="text-muted small mb-0 numeric">
                    Version 1.0.0
                </p>
            </div>
        </div>
    </div>
</footer>