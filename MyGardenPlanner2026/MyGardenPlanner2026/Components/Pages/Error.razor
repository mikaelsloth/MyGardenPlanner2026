@page "/Error"
@layout MyGardenPlanner2026.Components.Layout.PublicLayout

<PageTitle>Fejl – MyGardenPlanner</PageTitle>

<section class="section">
    <div class="container-fluid px-3 px-md-4">
        <div class="empty-state empty-error">
            <div class="empty-icon" aria-hidden="true">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div class="empty-content">
                <h1>Der opstod en fejl</h1>
                <p>Der opstod en fejl under behandlingen af din forespørgsel.</p>
                @if (ShowRequestId)
                {
                    <p class="meta"><strong>Forespørgsels-ID:</strong> <code class="mono">@RequestId</code></p>
                }
            </div>
            <div class="empty-actions">
                <a href="/" class="btn btn-primary">Gå til forsiden</a>
            </div>
        </div>

        <div class="status-message status-warning status-section" role="status">
            <span class="status-dot" aria-hidden="true"></span>
            <div class="status-message-text">
                <strong>Udviklingstilstand</strong>
                <p>
                    Hvis du skifter til miljøet <strong>Development</strong>, vises flere detaljer om den opståede fejl.
                </p>
                <p>
                    <strong>Development</strong>-miljøet bør ikke være aktiveret for udgivne applikationer,
                    da det kan resultere i, at følsomme oplysninger fra exceptions vises til slutbrugere.
                    For lokal fejlsøgning aktiveres <strong>Development</strong>-miljøet ved at sætte miljøvariablen
                    <strong>ASPNETCORE_ENVIRONMENT</strong> til <strong>Development</strong> og genstarte app'en.
                </p>
            </div>
        </div>
    </div>
</section>
