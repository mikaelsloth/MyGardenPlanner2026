@page "/Account/Manage/Passkeys"

@using MyGardenPlanner2026.Core.Entities;
@using Microsoft.AspNetCore.Identity
@using System.Buffers.Text

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Administrer dine passkeys – MyGardenPlanner</PageTitle>

<h3>Administrer dine passkeys</h3>

<StatusMessage />

@if (currentPasskeys is { Count: > 0 })
{
    <table class="table">
        <tbody>
            @foreach (var passkey in currentPasskeys)
            {
                <tr>
                    <td>@(passkey.Name ?? "Passkey uden navn")</td>
                    <td>
                        @{
                            var credentialId = Base64Url.EncodeToString(passkey.CredentialId);
                        }
                        <form @formname="@($"update-passkey-{credentialId}")" @onsubmit="UpdatePasskeyAsync" method="post">
                            <AntiforgeryToken />
                            <div>
                                <input type="hidden" name="CredentialId" value="@credentialId" />
                                <button type="submit" name="Action" value="rename" class="btn btn-primary" title="Omdøb denne passkey">Omdøb</button>
                                <button type="submit" name="Action" value="delete" class="btn btn-danger" title="Fjern denne passkey fra din konto">Slet</button>
                            </div>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Der er ikke registreret nogen passkeys.</p>
}

<form @formname="add-passkey" @onsubmit="AddPasskeyAsync" method="post">
    <AntiforgeryToken />
    @if (currentPasskeys is { Count: >= MaxPasskeyCount })
    {
        <p class="text-danger">Du har nået det maksimale antal tilladte passkeys. Slet en, før du tilføjer en ny.</p>
    }
    else
    {
        <PasskeySubmit Operation="PasskeyOperation.Create" Name="Input" class="btn btn-primary">Tilføj en ny passkey</PasskeySubmit>
    }

</form>