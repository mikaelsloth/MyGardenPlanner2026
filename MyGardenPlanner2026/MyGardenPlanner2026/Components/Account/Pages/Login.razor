@page "/Account/Login"
@layout MyGardenPlanner2026.Components.Layout.PublicLayout

@using Microsoft.AspNetCore.Identity
@using MyGardenPlanner2026.Core.Entities;

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Log ind – MyGardenPlanner</PageTitle>

<AuthPageShell Title="Log ind" Subtitle="Velkommen tilbage til din have.">
    <StatusMessage Message="@errorMessage" />
    <EditForm EditContext="editContext" method="post" OnSubmit="LoginUser" FormName="login">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />

        <div class="field">
            <label class="field-label" for="Input.Email">E-mail</label>
            <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username webauthn" aria-required="true" placeholder="navn@eksempel.dk" />
            <ValidationMessage For="() => Input.Email" class="field-message" />
        </div>

        <div class="field">
            <label class="field-label" for="Input.Password">Adgangskode</label>
            <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Din adgangskode" />
            <ValidationMessage For="() => Input.Password" class="field-message" />
        </div>

        <div class="check-row">
            <InputCheckbox @bind-Value="Input.RememberMe" id="Input.RememberMe" class="form-check-input" />
            <label class="field-label" for="Input.RememberMe">Husk mig</label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary w-100">Log ind</button>
        </div>

        <div class="d-flex flex-column align-items-center stack-xs">
            <span class="text-secondary">ELLER</span>
            <PasskeySubmit Operation="PasskeyOperation.Request" Name="Input.Passkey" EmailName="Input.Email" class="btn btn-ghost">Log ind med en passkey</PasskeySubmit>
        </div>

        <div class="stack-2xs">
            <a href="Account/ForgotPassword">Glemt din adgangskode?</a><br />
            <a href="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))">Opret ny bruger</a><br />
            <a href="Account/ResendEmailConfirmation">Gensend bekræftelses-e-mail</a>
        </div>
    </EditForm>

    <hr />
    <div class="stack-xs">
        <h2 class="h6">Brug en anden tjeneste til at logge ind</h2>
        <ExternalLoginPicker />
    </div>
</AuthPageShell>